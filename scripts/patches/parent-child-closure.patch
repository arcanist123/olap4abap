+    /**
+     * The member and its descendants, read without the subcube (the query's
+     * schema reader restricts members to it).
+     */
+    private List<Member> getParentChildSubtree(Member member) {
+        final SchemaReader schemaReader =
+            cube.getSchemaReader(null).withLocus();
+        final List<Member> subtree = new ArrayList<Member>();
+        subtree.add(member);
+        for (int i = 0; i < subtree.size(); i++) {
+            subtree.addAll(schemaReader.getMemberChildren(subtree.get(i)));
+        }
+        return subtree;
+    }
