* Deletes the generated objects no catalog's schema names (ZZXXMLA1_CL_SCHEMA_API=>orphans): the views of
* ZZXXMLA1_CL_BW_VIEW_GEN (filtered, plain and fact views, and its DDL sources without row of ZZXXMLA1_VIEW) and the
* hierarchy copies (node, closure and path table, not-assigned view) of the characteristics no schema names a BW
* hierarchy of. Accept and remove of the schema API delete the filtered views and the copies already; the plain views
* they keep (other schemas can use them) are regenerated by the next accept that needs them. In test mode the objects
* are only listed. Nothing is deleted if a schema of the data sources cannot be read.
REPORT zzxxmla1_delete_orphans LINE-SIZE 255.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 1(30) t_test FOR FIELD p_test.
PARAMETERS p_test AS CHECKBOX DEFAULT abap_true.
SELECTION-SCREEN END OF LINE.

INITIALIZATION.
  t_test = 'Test run (only list)'.

START-OF-SELECTION.
  DATA orphans TYPE zzxxmla1_cl_schema_api=>ty_t_orphan.
  TRY.
      orphans = NEW zzxxmla1_cl_schema_api( )->orphans( p_test ).
    CATCH zzxxmla1_cx_api_refused INTO DATA(refused).
      FORMAT COLOR COL_NEGATIVE.
      WRITE / |Nothing deleted: { refused->message }|.
      FORMAT COLOR OFF.
      RETURN.
  ENDTRY.
  IF orphans IS INITIAL.
    WRITE / 'No orphaned views or hierarchy copies.'.
    RETURN.
  ENDIF.
  WRITE / COND string( WHEN p_test = abap_true THEN 'Test run: these objects would be deleted.'
                       ELSE 'Deleted objects:' ).
  SKIP.
  FORMAT COLOR COL_HEADING.
  WRITE: / 'Kind', 18 'Characteristic', 50 'Objects', 130 'Selection or error'.
  FORMAT COLOR OFF.
  ULINE.
  LOOP AT orphans INTO DATA(orphan).
    DATA(kind) = SWITCH string( orphan-kind
                                WHEN zzxxmla1_cl_bw_view_gen=>c_kind-characteristic THEN `View`
                                WHEN zzxxmla1_cl_bw_view_gen=>c_kind-fact THEN `Fact view`
                                WHEN zzxxmla1_cl_schema_api=>c_orphan_hierarchy THEN `Hierarchy copy`
                                ELSE `` ).
    DATA(objects) = concat_lines_of( table = orphan-objects sep = ` ` ).
    IF orphan-error IS NOT INITIAL.
      FORMAT COLOR COL_NEGATIVE.
      WRITE: / kind, 18 orphan-characteristic, 50 objects, 130 orphan-error.
      FORMAT COLOR OFF.
    ELSE.
      WRITE: / kind, 18 orphan-characteristic, 50 objects, 130 orphan-selection.
    ENDIF.
  ENDLOOP.
  ULINE.
  WRITE / |{ lines( orphans ) } entries|.
