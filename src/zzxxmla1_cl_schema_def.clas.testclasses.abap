  METHOD assert_schema.
    " the definition written back line by line, or the error as the reference's dump prints it
    DATA act TYPE string_table.
    TRY.
        DATA(xml) = zzxxmla1_cl_schema_def=>to_xml(
          zzxxmla1_cl_schema_def=>parse( concat_lines_of( table = input sep = cl_abap_char_utilities=>newline ) ) ).
        SPLIT xml AT cl_abap_char_utilities=>newline INTO TABLE act.
      CATCH zzxxmla1_cx_xom INTO DATA(error).
        act = VALUE #( ( |ERROR: { error->error_message }| ) ).
    ENDTRY.
    cl_abap_unit_assert=>assert_equals( act = act exp = exp ).
  ENDMETHOD.

