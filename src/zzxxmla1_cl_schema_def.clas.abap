      WHEN `DrillThroughAttribute`.
        result-def = NEW ty_drill_through_attribute( parse_drill_through_attribute( element ) ).
      WHEN `DrillThroughMeasure`.
        result-def = NEW ty_drill_through_measure( parse_drill_through_measure( element ) ).
      WHEN `DrillThroughAction`.
        result-def = NEW ty_drill_through_action( parse_drill_through_action( element ) ).
      WHEN `WritebackAttribute`.
        result-def = NEW ty_writeback_attribute( parse_writeback_attribute( element ) ).
      WHEN `WritebackMeasure`.
        result-def = NEW ty_writeback_measure( parse_writeback_measure( element ) ).
      WHEN `WritebackTable`.
        result-def = NEW ty_writeback_table( parse_writeback_table( element ) ).
      WHEN `DimensionAttribute`.
        result-def = NEW ty_dimension_attribute( parse_dimension_attribute( element ) ).
      WHEN `AttributeMapping`.
        result-def = NEW ty_attribute_mapping( parse_attribute_mapping( element ) ).
      WHEN `DataItem`.
        result-def = NEW ty_data_item( parse_data_item( element ) ).
      WHEN `KeyColumn`.
        result-def = NEW ty_key_column( parse_key_column( element ) ).
      WHEN `OrderByColumn`.
        result-def = NEW ty_order_by_column( parse_order_by_column( element ) ).
      WHEN `NameColumn`.
        result-def = NEW ty_name_column( parse_name_column( element ) ).
      WHEN `ValueColumn`.
        result-def = NEW ty_value_column( parse_value_column( element ) ).
      WHEN `ParentColumn`.
        result-def = NEW ty_parent_column( parse_parent_column( element ) ).
      WHEN OTHERS.
        " an abstract class: Class.newInstance fails with an InstantiationException without message
        RAISE EXCEPTION TYPE zzxxmla1_cx_xom
          EXPORTING error_message = |Unable to instantiate object of class olap4abap.SchemaDef${ result-name }: null|.
    ENDCASE.
  ENDMETHOD.

  METHOD write_node.
    FIELD-SYMBOLS <def> TYPE any.
    IF node-def IS NOT BOUND.
      RETURN.
    ENDIF.
    ASSIGN node-def->* TO <def>.
    CASE node-name.
      WHEN `Schema`.
        write_schema( def = <def> out = out ).
      WHEN `Cube`.
        write_cube( def = <def> out = out ).
      WHEN `VirtualCube`.
        write_virtual_cube( def = <def> out = out ).
      WHEN `CubeUsages`.
