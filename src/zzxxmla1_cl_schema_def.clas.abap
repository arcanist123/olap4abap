"! The definition of a schema: the port of SchemaDef, the classes eigenbase-xom generates from
"! the reference's meta-model of a schema. Generated by scripts/generate-schema-def.py from the reference's classes: do not
"! edit by hand. parse reads a schema as the reference does (XOMUtil's parser, then new SchemaDef.Schema): one
"! structure per element class, attributes with their defaults and legal values, child elements in the order of
"! the definition, an error with the reference's message. to_xml writes a definition as toXML does.
"! Values as the reference holds them: a String attribute or a text that is null is initial (an empty attribute is no
"! attribute), a Boolean is abap_true, abap_false or abap_undefined (null), an Integer or Long is its decimal text,
"! an element a reference (not bound: null), an array a table. A field whose class is abstract (RelationOrJoin,
"! CubeDimension, ...) is a ty_node with the class of the element and a reference to its structure, e.g.
"! CAST zzxxmla1_cl_schema_def=>ty_table( node-def ) for node-name Table.
CLASS zzxxmla1_cl_schema_def DEFINITION
  PUBLIC
  FINAL
  CREATE PRIVATE.

  PUBLIC SECTION.
    TYPES:
      "! An element of a field whose class is abstract: name is the class of the element (getName, e.g. Table),
      "! def a reference to its structure (e.g. ty_table); initial for null.
      BEGIN OF ty_node,
        name TYPE string,
        def  TYPE REF TO data,
      END OF ty_node,
      ty_t_node TYPE STANDARD TABLE OF ty_node WITH EMPTY KEY.
    TYPES:
      "! Annotation
      BEGIN OF ty_annotation,
        name  TYPE string,  " attribute name, required
        cdata TYPE string,  " text
      END OF ty_annotation,
      ty_t_annotation TYPE STANDARD TABLE OF ty_annotation WITH EMPTY KEY.
    TYPES:
      "! Annotations
      BEGIN OF ty_annotations,
        array TYPE ty_t_annotation,  " array of Annotation
      END OF ty_annotations,
      ty_t_annotations TYPE STANDARD TABLE OF ty_annotations WITH EMPTY KEY.
