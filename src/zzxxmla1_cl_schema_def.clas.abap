  METHOD parse_schema.
    TRY.
        DATA(parser) = NEW zzxxmla1_cl_xom_parser( element ).
        DATA child TYPE REF TO if_ixml_element.
        result-name = parser->get_string( name = `name` required = abap_true ).
        result-description = parser->get_string( name = `description` ).
        result-measures_caption = parser->get_string( name = `measuresCaption` ).
        result-default_role = parser->get_string( name = `defaultRole` ).
        child = parser->get_element( classes = value_list( `Annotations` )
                                     java_class = `olap4abap.SchemaDef$Annotations`
                                     required = abap_false ).
        IF child IS BOUND.
          result-annotations = NEW #( parse_annotations( child ) ).
        ENDIF.
        LOOP AT parser->get_array( classes = value_list( `Parameter` )
                                   java_class = `olap4abap.SchemaDef$Parameter`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_parameter( child ) INTO TABLE result-parameters.
        ENDLOOP.
        LOOP AT parser->get_array( classes = value_list( `View` )
                                   java_class = `olap4abap.SchemaDef$View`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_view( child ) INTO TABLE result-views.
        ENDLOOP.
        LOOP AT parser->get_array( classes = value_list( `Dimension` )
                                   java_class = `olap4abap.SchemaDef$Dimension`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_dimension( child ) INTO TABLE result-dimensions.
        ENDLOOP.
        LOOP AT parser->get_array( classes = value_list( `Cube` )
                                   java_class = `olap4abap.SchemaDef$Cube`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_cube( child ) INTO TABLE result-cubes.
        ENDLOOP.
        LOOP AT parser->get_array( classes = value_list( `VirtualCube` )
                                   java_class = `olap4abap.SchemaDef$VirtualCube`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_virtual_cube( child ) INTO TABLE result-virtual_cubes.
        ENDLOOP.
        LOOP AT parser->get_array( classes = value_list( `NamedSet` )
                                   java_class = `olap4abap.SchemaDef$NamedSet`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_named_set( child ) INTO TABLE result-named_sets.
        ENDLOOP.
        LOOP AT parser->get_array( classes = value_list( `Role` )
                                   java_class = `olap4abap.SchemaDef$Role`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_role( child ) INTO TABLE result-roles.
        ENDLOOP.
        LOOP AT parser->get_array( classes = value_list( `UserDefinedFunction` )
                                   java_class = `olap4abap.SchemaDef$UserDefinedFunction`
                                   min = 0
                                   max = 0 ) INTO child.
          INSERT parse_user_defined_function( child ) INTO TABLE result-user_defined_functions.
        ENDLOOP.
      CATCH zzxxmla1_cx_xom INTO DATA(error).
        RAISE EXCEPTION TYPE zzxxmla1_cx_xom EXPORTING error_message = |In Schema: { error->error_message }|.
    ENDTRY.
  ENDMETHOD.

  METHOD write_schema.
    out->begin_tag( name = `Schema` attributes = VALUE #(
      ( name = `name` value = def-name )
      ( name = `description` value = def-description )
      ( name = `measuresCaption` value = def-measures_caption )
      ( name = `defaultRole` value = def-default_role )
    ) ).
    IF def-annotations IS BOUND.
