      WHEN `AggExclude`.
        result-def = NEW ty_agg_exclude( parse_agg_exclude( element ) ).
      WHEN `AggFactCount`.
        result-def = NEW ty_agg_fact_count( parse_agg_fact_count( element ) ).
      WHEN `AggMeasureFactCount`.
        result-def = NEW ty_agg_measure_fact_count( parse_agg_measure_fact_count( element ) ).
      WHEN `AggIgnoreColumn`.
        result-def = NEW ty_agg_ignore_column( parse_agg_ignore_column( element ) ).
      WHEN `AggForeignKey`.
        result-def = NEW ty_agg_foreign_key( parse_agg_foreign_key( element ) ).
      WHEN `AggLevel`.
        result-def = NEW ty_agg_level( parse_agg_level( element ) ).
