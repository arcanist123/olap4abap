CLASS zzxxmla1_cl_schema_def IMPLEMENTATION.

  METHOD parse.
    result = parse_schema( zzxxmla1_cl_xom_parser=>parse_document( xml ) ).
  ENDMETHOD.

  METHOD to_xml.
    DATA(out) = NEW zzxxmla1_cl_xom_output( ).
    write_schema( def = schema out = out ).
    result = out->get_output( ).
  ENDMETHOD.

  METHOD value_list.
    SPLIT text AT `,` INTO TABLE result.
  ENDMETHOD.

  METHOD parse_node.
    result-name = zzxxmla1_cl_xom_parser=>class_name( element ).
    CASE result-name.
      WHEN `Schema`.
        result-def = NEW ty_schema( parse_schema( element ) ).
      WHEN `Cube`.
        result-def = NEW ty_cube( parse_cube( element ) ).
      WHEN `VirtualCube`.
        result-def = NEW ty_virtual_cube( parse_virtual_cube( element ) ).
      WHEN `CubeUsages`.
        result-def = NEW ty_cube_usages( parse_cube_usages( element ) ).
      WHEN `CubeUsage`.
        result-def = NEW ty_cube_usage( parse_cube_usage( element ) ).
      WHEN `VirtualCubeDimension`.
        result-def = NEW ty_virtual_cube_dimension( parse_virtual_cube_dimension( element ) ).
      WHEN `VirtualCubeMeasure`.
        result-def = NEW ty_virtual_cube_measure( parse_virtual_cube_measure( element ) ).
      WHEN `DimensionUsage`.
        result-def = NEW ty_dimension_usage( parse_dimension_usage( element ) ).
      WHEN `Dimension`.
        result-def = NEW ty_dimension( parse_dimension( element ) ).
      WHEN `Hierarchy`.
        result-def = NEW ty_hierarchy( parse_hierarchy( element ) ).
      WHEN `Level`.
        result-def = NEW ty_level( parse_level( element ) ).
      WHEN `Closure`.
        result-def = NEW ty_closure( parse_closure( element ) ).
      WHEN `Property`.
        result-def = NEW ty_property( parse_property( element ) ).
      WHEN `Measure`.
        result-def = NEW ty_measure( parse_measure( element ) ).
      WHEN `CalculatedMember`.
        result-def = NEW ty_calculated_member( parse_calculated_member( element ) ).
      WHEN `CalculatedMemberProperty`.
        result-def = NEW ty_calc_member_property( parse_calc_member_property( element ) ).
      WHEN `NamedSet`.
        result-def = NEW ty_named_set( parse_named_set( element ) ).
      WHEN `Formula`.
        result-def = NEW ty_formula( parse_formula( element ) ).
      WHEN `MemberReaderParameter`.
        result-def = NEW ty_member_reader_parameter( parse_member_reader_parameter( element ) ).
      WHEN `View`.
        result-def = NEW ty_view( parse_view( element ) ).
      WHEN `SQL`.
        result-def = NEW ty_sql( parse_sql( element ) ).
      WHEN `SchemaView`.
        result-def = NEW ty_schema_view( parse_schema_view( element ) ).
      WHEN `Join`.
        result-def = NEW ty_join( parse_join( element ) ).
      WHEN `Table`.
        result-def = NEW ty_table( parse_table( element ) ).
      WHEN `Hint`.
        result-def = NEW ty_hint( parse_hint( element ) ).
      WHEN `InlineTable`.
        result-def = NEW ty_inline_table( parse_inline_table( element ) ).
      WHEN `ColumnDefs`.
        result-def = NEW ty_column_defs( parse_column_defs( element ) ).
      WHEN `ColumnDef`.
        result-def = NEW ty_column_def( parse_column_def( element ) ).
      WHEN `Rows`.
        result-def = NEW ty_rows( parse_rows( element ) ).
      WHEN `Row`.
        result-def = NEW ty_row( parse_row( element ) ).
      WHEN `Value`.
        result-def = NEW ty_value( parse_value( element ) ).
      WHEN `AggName`.
