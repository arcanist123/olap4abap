  METHOD query_plan_js.
    DATA parts TYPE string_table.
    APPEND |// The query plan and the SQL statements of a traced call, shown alike by the MDX console (console.js) and the trace\n// page (trace.js). A call is the traced call as GET api/trace| TO parts.
    APPEND |/entry gives it (ZZXXMLA1_CL_TRACE): id, mdx, runtimeMs,\n// sqlCount, sqlMs, sql (each statement with its rows, time, error, phase and node) and explain (ZZXXMLA1_CL_MDX_EXPLAIN:| TO parts.
    APPEND |\n// the resolved tree with the planner's marks; null for a call that is no Execute or failed before it was resolved);\n// the console adds browserMs.\nimport \{ html, useState, us| TO parts.
    APPEND |eEffect \} from './vendor/htm-preact-standalone.mjs';\nimport \{ sqlScript, sqlStatementScript, copyText, download \} from './trace-text.js';\nimport \{ formatSql \} from './sql-fo| TO parts.
    APPEND |rmat.js';\n\nexport const msText = (ms) => `$\{Math.round(ms).toLocaleString()\} ms`;\nexport const statementCount = (n) => `$\{n.toLocaleString()\} SQL $\{n === 1 ? 'statement' : | TO parts.
    APPEND |'statements'\}`;\n\n// Copy and its feedback for a moment\nexport function useCopied() \{\n  const [copied, setCopied] = useState('');\n  useEffect(() => \{\n    if (!copied) retur| TO parts.
    APPEND |n undefined;\n    const timer = setTimeout(() => setCopied(''), 1500);\n    return () => clearTimeout(timer);\n  \}, [copied]);\n  const copy = (text) => copyText(text).then((ok) =| TO parts.
    APPEND |> setCopied(ok ? 'Copied' : 'Copy failed: select the text and press Ctrl+C'));\n  const status = copied && html`<span class=$\{`status $\{copied === 'Copied' ? 'ok' : 'err'\}`\} ro| TO parts.
    APPEND |le="status">$\{copied\}</span>`;\n  return [copy, status];\n\}\n\n// What the engine did when a statement ran (ZZXXMLA1_CL_MDX_ENGINE's phases, ZZXXMLA1_CL_SQL=>log_phase)\nconst P| TO parts.
    APPEND |HASE_TEXT = \{\n  '': 'before the query: the schema and its metadata',\n  Resolve: 'resolving the names of the query: the columns and the members it names',\n  Prepare: 'the member| TO parts.
    APPEND |s of hierarchies without an All member',\n  Slicer: 'the slicer (WHERE)',\n  Axes: 'the cells the axes needed, read in one batch',\n  'NON EMPTY': 'the NON EMPTY filter of the axes| TO parts.
    APPEND |',\n  Cells: 'the cells of the answer',\n  'Cells first': 'the axes and the cells from one statement of the facts',\n  Finish: 'the details of the axes\\' members: children counts'| TO parts.
    APPEND |,\n  Drillthrough: 'the fact rows of the drill-through',\n\};\nconst phaseName = (p) => p \|\| 'Before';\nconst phaseText = (p) => PHASE_TEXT[p] ?? (/^Axis\\d+$/.test(p) ? `axis $| TO parts.
    APPEND |\{p.slice(4)\}: its sets and members` : p);\nconst MARK_TEXT = \{\n  STATIC: 'static: answered by the schema and member reads',\n  RELATIONAL: 'relational: answered by grouped SQL | TO parts.
    APPEND |over the facts',\n  COMPUTED: 'computed: evaluated by the evaluator, cell by cell',\n\};\n\n// the explanation's nodes by id, each with its parent's id (0 for the top of a part) an| TO parts.
    APPEND |d its part\nfunction explainIndex(explain) \{\n  const nodes = new Map();\n  const visit = (node, parent, part) => \{\n    if (!node \|\| node.ref) return;\n    nodes.set(node.id, | TO parts.
    APPEND |\{ node, parent, part \});\n    node.args.forEach((a) => visit(a, node.id, part));\n  \};\n  const visitPart = (part) => \{\n    visit(part.node, 0, part);\n    (part.children \|\|| TO parts.
    APPEND | []).forEach(visitPart);\n  \};\n  (explain?.parts \|\| []).forEach(visitPart);\n  return nodes;\n\}\n\n// whether a statement was read by the node or one of its arguments\nconst r| TO parts.
    APPEND |eadBelow = (statement, id, nodes) => \{\n  for (let n = statement.node; n; n = nodes.get(n)?.parent) if (n === id) return true;\n  return false;\n\};\n\n// the statements and their| TO parts.
    APPEND | time per node (own: read by it; all: by it or its arguments) and per phase\nfunction sqlStats(statements, nodes) \{\n  const add = (map, key, s) => \{\n    const v = map.get(key) | TO parts.
    APPEND |\|\| \{ count: 0, us: 0 \};\n    v.count += 1;\n    v.us += s.us;\n    map.set(key, v);\n  \};\n  const own = new Map();\n  const all = new Map();\n  const phases = new Map();\n  f| TO parts.
    APPEND |or (const s of statements) \{\n    add(phases, s.phase \|\| '', s);\n    if (!s.node) continue;\n    add(own, s.node, s);\n    for (let n = s.node; n; n = nodes.get(n)?.parent) add| TO parts.
    APPEND |(all, n, s);\n  \}\n  return \{ own, all, phases \};\n\}\n\nconst serverTime = (call) => `$\{msText(call.runtimeMs)\} on the server`\n  + (call.browserMs != null ? ` ($\{msText(cal| TO parts.
    APPEND |l.browserMs)\} in the browser)` : '');\n\nconst Mark = (\{ mark \}) => mark && html`<span class=$\{`mark $\{mark.toLowerCase()\}`\} title=$\{MARK_TEXT[mark] \|\| mark\}>$\{mark.toL| TO parts.
    APPEND |owerCase()\}</span>`;\nconst SqlBadge = (\{ stat, title \}) => stat && html`<span class="sql-badge" title=$\{title\}>$\{stat.count\} SQL { cl_abap_conv_in_ce=>uccp( '00B7' ) } $\{m| TO parts.
    APPEND |sText(stat.us / 1000)\}</span>`;\n\n// statements with their time (a bar shows its share of the slowest), rows, phase, element and error, each to\n// download on its own, formatted| TO parts.
    APPEND | (name: the file name before -<n>.sql)\nfunction SqlTable(\{ statements, slowest, nodes, name, onNode, onPhase \}) \{\n  if (!statements.length) return html`<div class="result-msg | TO parts.
