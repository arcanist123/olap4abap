    APPEND |v class="notice err">A statement failed; its error is below it.</div>`\}\n    <div class="result-table">\n      <$\{SqlTable\} statements=$\{statements\} slowest=$\{Math.max(1, ...| TO parts.
    APPEND |call.sql.map((s) => s.us))\} nodes=$\{nodes\}\n        name=$\{call.id\} onNode=$\{onNode\} onPhase=$\{onPhase\} />\n    </div>`;\n\}\n\n// The query plan as text to read or pass o| TO parts.
    APPEND |n: the statement, the plan's marks, the server's time, the phases, the tree\n// (each element with its type, mark and the SQL statements it and its arguments read; #n numbers the e| TO parts.
    APPEND |lements) and\n// the SQL statements, each with its phase and element\nexport function planText(call) \{\n  const \{ explain \} = call;\n  const nodes = explainIndex(explain);\n  co| TO parts.
    APPEND |nst stats = sqlStats(call.sql, nodes);\n  const sql = (stat) => (stat ? `  [$\{stat.count\} SQL, $\{msText(stat.us / 1000)\}]` : '');\n  const lines = [`Query plan of $\{explain.cu| TO parts.
