"! edit, change web/schema/ and generate again. ZZXXMLA1_CL_WEB_APP serves them below /schema/.
CLASS zzxxmla1_cl_web_app_files DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    TYPES:
      BEGIN OF ty_file,
        path    TYPE string,
        content TYPE string,
      END OF ty_file.

    "! The file of a path below the ICF node (/schema/app.js); initial if the app has none.
    CLASS-METHODS file
      IMPORTING !path         TYPE string
      RETURNING VALUE(result) TYPE ty_file.
  PROTECTED SECTION.
  PRIVATE SECTION.
    "! /schema/app.css
    CLASS-METHODS app_css
      RETURNING VALUE(result) TYPE string.
    "! /schema/app.js
    CLASS-METHODS app_js
      RETURNING VALUE(result) TYPE string.
    "! /schema/console.html
    CLASS-METHODS console_html
      RETURNING VALUE(result) TYPE string.
    "! /schema/console.js
    CLASS-METHODS console_js
      RETURNING VALUE(result) TYPE string.
    "! /schema/index.html
    CLASS-METHODS index_html
      RETURNING VALUE(result) TYPE string.
    "! /schema/time.html
    CLASS-METHODS time_html
      RETURNING VALUE(result) TYPE string.
    "! /schema/time.js
    CLASS-METHODS time_js
      RETURNING VALUE(result) TYPE string.
    "! /schema/trace.html
    CLASS-METHODS trace_html
      RETURNING VALUE(result) TYPE string.
    "! /schema/trace.js
    CLASS-METHODS trace_js
      RETURNING VALUE(result) TYPE string.
    "! /schema/vendor/htm-preact-standalone.mjs
    CLASS-METHODS htm_preact_standalone_mjs
      RETURNING VALUE(result) TYPE string.
ENDCLASS.



CLASS zzxxmla1_cl_web_app_files IMPLEMENTATION.

  METHOD file.
    result-path = path.
    CASE path.
      WHEN `/schema/app.css`.
        result-content = app_css( ).
      WHEN `/schema/app.js`.
        result-content = app_js( ).
      WHEN `/schema/console.html`.
        result-content = console_html( ).
      WHEN `/schema/console.js`.
        result-content = console_js( ).
      WHEN `/schema/index.html`.
        result-content = index_html( ).
      WHEN `/schema/time.html`.
        result-content = time_html( ).
      WHEN `/schema/time.js`.
        result-content = time_js( ).
      WHEN `/schema/trace.html`.
        result-content = trace_html( ).
      WHEN `/schema/trace.js`.
        result-content = trace_js( ).
      WHEN `/schema/vendor/htm-preact-standalone.mjs`.
        result-content = htm_preact_standalone_mjs( ).
      WHEN OTHERS.
        CLEAR result.
    ENDCASE.
