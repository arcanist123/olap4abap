    APPEND |abap.trace.max';\n// the number of calls listed is remembered per browser; storage may be unavailable (private windows)\nconst storedMax = () => \{\n  try \{\n    const n = Number(| TO parts.
    APPEND |localStorage.getItem(MAX_KEY));\n    return MAX_CHOICES.includes(n) ? n : 200;\n  \} catch \{\n    return 200;\n  \}\n\};\n\nconst apiUrl = (resource, params = \{\}) => \{\n  const| TO parts.
    APPEND | query = new URLSearchParams(Object.entries(params).filter(([, v]) => v));\n  if (client) query.set('sap-client', client);\n  return `api/$\{resource\}?$\{query\}`;\n\};\n\nasync f| TO parts.
    APPEND |unction api(method, resource, params = \{\}) \{\n  const response = await fetch(apiUrl(resource, params), \{ method \});\n  let data;\n  try \{\n    data = await response.json();\n| TO parts.
    APPEND |  \} catch \{\n    throw new Error(`$\{response.status\} $\{response.statusText\}`);\n  \}\n  if (!response.ok) throw new Error(data.error \|\| `$\{response.status\} $\{response.st| TO parts.
    APPEND |atusText\}`);\n  return data;\n\}\n\nconst time = (iso) => iso ? new Date(iso).toLocaleString() : '';\nconst size = (n) => n >= 1048576 ? `$\{(n / 1048576).toFixed(1)\} MB` : n >= | TO parts.
    APPEND |1024 ? `$\{(n / 1024).toFixed(1)\} KB` : `$\{n\} B`;\nconst KINDS = [['DISCOVER', 'Discover'], ['EXECUTE', 'Execute'], ['CHECK', 'Check']];\nconst what = (c) => KINDS.find(([k]) =>| TO parts.
    APPEND | k === c.method)?.[1] \|\| '(no XMLA)';\nconst isCheck = (c) => c.method === 'CHECK';\nconst prettyJson = (s) => \{\n  try \{\n    return JSON.stringify(JSON.parse(s), null, 2);\n | TO parts.
    APPEND | \} catch \{\n    return s;\n  \}\n\};\nconst firstLine = (s) => s.replace(/\\s+/g, ' ').trim();\n\n// the Catalog property of an Execute request, initial if it names none\nfunctio| TO parts.
    APPEND |n requestCatalog(xml) \{\n  const doc = new DOMParser().parseFromString(xml \|\| '', 'application/xml');\n  const element = doc.getElementsByTagNameNS('*', 'Catalog')[0];\n  return| TO parts.
    APPEND | element ? element.textContent.trim() : '';\n\}\n\n// the MDX console with a traced Execute: its statement and catalog in the editor, the call itself (answer, request,\n// query pl| TO parts.
    APPEND |an, SQL statements) as the result (console.js reads the fragment); a check in the console's mode for BW's\n// MDX with its user and key date (the type: "USER YYYY-MM-DD")\nconst co| TO parts.
    APPEND |nsoleUrl = (entry) => \{\n  const fragment = new URLSearchParams(\{ statement: entry.mdx, trace: entry.id \});\n  if (isCheck(entry)) \{\n    const [user, keyDate] = entry.type.spl| TO parts.
    APPEND |it(' ');\n    fragment.set('mode', 'bw');\n    fragment.set('user', user \|\| '');\n    fragment.set('keyDate', keyDate \|\| '');\n    return `console.html$\{location.search\}#$\{f| TO parts.
    APPEND |ragment\}`;\n  \}\n  const catalog = requestCatalog(entry.request);\n  if (catalog) fragment.set('catalog', catalog);\n  return `console.html$\{location.search\}#$\{fragment\}`;\n| TO parts.
    APPEND |\};\n\nfunction Users(\{ state, onSwitch, busy \}) \{\n  const [user, setUser] = useState('');\n  const name = (user \|\| state.user).trim().toUpperCase();\n  const on = state.user| TO parts.
    APPEND |s.some((u) => u.user === name);\n  return html`<section class="section">\n    <header><h2>Traced users</h2><span class="spacer"></span>\n      <span class="muted small">a trace swi| TO parts.
