    APPEND |lass="muted small">$\{`$\{statementCount(call.sqlCount)\}, $\{msText(call.sqlMs)\} of $\{serverTime(call)\}`\}</span>\n      <span class="spacer"></span>\n      <div class="segment| TO parts.
    APPEND |ed" role="group" aria-label="Order">\n        <button class=$\{order === 'ran' ? 'active' : ''\} onClick=$\{() => setOrder('ran')\}>As they ran</button>\n        <button class=$\{o| TO parts.
    APPEND |rder === 'slowest' ? 'active' : ''\} onClick=$\{() => setOrder('slowest')\}>Slowest first</button>\n      </div>\n      $\{children\}\n      $\{copied\}\n      <button onClick=$\{(| TO parts.
    APPEND |) => copy(sqlScript(call.sql))\} disabled=$\{!call.sql.length\} title="Copy the statements as one script, formatted">Copy</button>\n      <button onClick=$\{() => download(sqlScrip| TO parts.
    APPEND |t(call.sql), `$\{call.id\}.sql`, 'text/plain')\} disabled=$\{!call.sql.length\}\n        title="Download the statements as one script, formatted">Download</button>\n    </div>\n   | TO parts.
    APPEND | $\{call.sql.length < call.sqlCount && html`<div class="notice warn">$\{call.sql.length\n      ? `The first $\{call.sql.length.toLocaleString()\} of $\{call.sqlCount.toLocaleString| TO parts.
