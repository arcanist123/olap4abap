    APPEND |h>Element</th><th>Statement</th><th></th></tr></thead>\n    <tbody>$\{statements.map((s) => \{\n      const element = nodes.get(s.node)?.node;\n      return html`<tr>\n        <td | TO parts.
    APPEND |class="num muted">$\{s.n\}</td>\n        <td class="num" style=$\{`background: linear-gradient(to left, var(--accent-soft) $\{(100 * s.us) / slowest\}%, transparent 0)`\}>$\{(s.us | TO parts.
