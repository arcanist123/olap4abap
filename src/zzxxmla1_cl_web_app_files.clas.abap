  METHOD trace_text_js.
    DATA parts TYPE string_table.
    APPEND |// What the trace page (trace.js) and the MDX console (console.js) show of a call: its XML indented, its SQL\n// statements as a script, and Copy that works on plain HTTP too.\nimp| TO parts.
    APPEND |ort \{ formatSql \} from './sql-format.js';\n\nconst ms = (us) => (us / 1000).toFixed(1);\n\n// a statement of a call as a script: formatted (sql-format.js), after a comment with i| TO parts.
    APPEND |ts number n, rows and time\nexport const sqlStatementScript = (s, n) => `-- $\{n\}: $\{s.error ? `failed: $\{s.error.replace(/\\s+/g, ' ')\}`\n  : `$\{s.rows\} $\{s.rows === 1 ? 'r| TO parts.
    APPEND |ow' : 'rows'\}`\}, $\{ms(s.us)\} ms\\n$\{formatSql(s.sql.trim())\};`;\n\n// the SQL statements of a call as one script\nexport const sqlScript = (statements) => statements.map((s, | TO parts.
    APPEND |i) => sqlStatementScript(s, i + 1)).join('\\n\\n');\n\n// XML indented for reading: a line per tag, an element of text only (or none) on one line. The tags and text are\n// kept as| TO parts.
    APPEND | sent (no parser), so it also indents the beginning of a response cut off for showing, and it is quick on\n// megabytes.\nexport function prettyXml(text) \{\n  if (!text) return te| TO parts.
    APPEND |xt;\n  const tokens = text.split(/(<!--[\\s\\S]*?-->\|<!\\[CDATA\\[[\\s\\S]*?\\]\\]>\|<[^>]*>)/);\n  const out = [];\n  let depth = 0;\n  const isOpen = (t) => t.startsWith('<') &&| TO parts.
    APPEND | !t.startsWith('</') && !t.startsWith('<?') && !t.startsWith('<!') && !t.endsWith('/>');\n  for (let i = 0; i < tokens.length; i++) \{\n    const token = tokens[i];\n    if (!token| TO parts.
    APPEND | \|\| !token.trim()) continue;\n    const pad = '  '.repeat(depth);\n    if (!token.startsWith('<')) \{\n      out.push(pad + token.trim());\n    \} else if (token.startsWith('</')| TO parts.
    APPEND |) \{\n      depth = Math.max(0, depth - 1);\n      out.push('  '.repeat(depth) + token);\n    \} else if (isOpen(token)) \{\n      // <a>text</a> and <a></a> on one line\n      con| TO parts.
    APPEND |st next = tokens[i + 1] ?? '';\n      if (!next.includes('<') && tokens[i + 2]?.startsWith('</')) \{\n        out.push(pad + token + next + tokens[i + 2]);\n        i += 2;\n      | TO parts.
    APPEND |\} else \{\n        out.push(pad + token);\n        depth += 1;\n      \}\n    \} else \{\n      out.push(pad + token);\n    \}\n  \}\n  return out.join('\\n');\n\}\n\n// navigator| TO parts.
    APPEND |.clipboard exists only on HTTPS and localhost; the endpoint is often plain HTTP, so a hidden textarea and\n// execCommand('copy') are the fallback\nexport async function copyText(t| TO parts.
    APPEND |ext) \{\n  try \{\n    if (navigator.clipboard && window.isSecureContext) \{\n      await navigator.clipboard.writeText(text);\n      return true;\n    \}\n  \} catch \{ /* the fal| TO parts.
    APPEND |lback below */ \}\n  const area = Object.assign(document.createElement('textarea'), \{ value: text, readOnly: true \});\n  area.style.cssText = 'position:fixed;top:0;left:0;opacity| TO parts.
    APPEND |:0';\n  document.body.appendChild(area);\n  area.select();\n  let copied = false;\n  try \{ copied = document.execCommand('copy'); \} catch \{ copied = false; \}\n  area.remove();| TO parts.
    APPEND |\n  return copied;\n\}\n\nexport const download = (text, name, type = 'text/xml') => \{\n  const url = URL.createObjectURL(new Blob([text], \{ type \}));\n  const a = Object.assign| TO parts.
    APPEND |(document.createElement('a'), \{ href: url, download: name \});\n  a.click();\n  setTimeout(() => URL.revokeObjectURL(url), 1000);\n\};\n| TO parts.
    result = concat_lines_of( parts ).
  ENDMETHOD.

